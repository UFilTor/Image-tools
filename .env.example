# Anthropic API key for AI Smart Crop and the Logo page's Ask AI
ANTHROPIC_API_KEY=

# Vercel AI Gateway key for Extend's AI fill and the Logo page's Redraw image.
# Optional on Vercel: the project's OIDC token (VERCEL_OIDC_TOKEN) is used automatically.
# Locally, set this or run `vercel env pull` for a 12-hour VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
