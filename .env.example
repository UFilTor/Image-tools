# Anthropic API key for AI Smart Crop and the Logo page's Ask AI
ANTHROPIC_API_KEY=

# Vercel AI Gateway key for the Logo page's Redraw image (also behind Upscale's Redraw hint).
# Optional on Vercel: the project's OIDC token (VERCEL_OIDC_TOKEN) is used automatically.
# Locally, set this or run `vercel env pull` for a 12-hour VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# "Fetch from a website" misses go to a Google Sheet through its Apps Script web app
# (scripts/scrape-log-sheet.gs). Set both in Vercel Production only; leave them empty locally,
# so local and preview fetches never log.
SCRAPE_LOG_URL=
SCRAPE_LOG_SECRET=
